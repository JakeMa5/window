[plugin]
name = "window"
version = "0.1.0"
summary = "Opens the game window and draws the render graph."
category = "Core"
package = "snowdon-window"

entry_points = [
    "src.window.config:WindowConfig",
    "src.window.settings:WindowSettings",
    "src.window.plugin:WindowPlugin",
]

[plugin.capabilities]
provides = ["snowdon.display", "snowdon.render_graph"]
requires = []

[plugin.dependencies]
plugins = []
python = []
